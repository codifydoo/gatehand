# .github/agents/hooks/lib.sh (rename from lib.sh.example to enable). Optional, yours.
# Sourced last by .github/scripts/agent-lib.sh, from the default branch, in every agent script.
# Define only the hooks you need; an undefined hook is skipped.

# agent_hook_pr_guard <labels> <files-file>: extra rules for the `agent pr guard` check. Print one
# "FAIL: <reason>" line per broken rule. <labels> is newline-separated; <files-file> holds the PR's
# changed paths, one per line. Example: PRs labelled docs-only may change docs/ only.
# agent_hook_pr_guard() {
#   if grep -Fxq 'docs-only' <<<"$1"; then
#     hits="$(grep -v '^docs/' "$2" | grep -v '^$' | head -5)"
#     [[ -z "${hits}" ]] || printf 'FAIL: a docs-only PR changes paths outside docs/: %s\n' "$(tr '\n' ' ' <<<"${hits}")"
#   fi
# }

# agent_hook_inbox_<kind> approve|reject <REQ-id> <issue> <reason> <bot-comments>: handle answers to
# inbox requests your own workflows post with `inbox_request <kind> ...`. Print the reply line
# ("- `REQ-…` approved: …"); exit 0 to record the request as answered.

# agent_hook_digest_sections: print extra weekly digest sections (markdown, `### ` headings).
# Exit 1 when part of it could not be read; the rest of the digest still posts.

# agent_hook_digest_done_pending <issue> <title> <pr or empty> <issue-json>: one line replacing the
# digest's default for an agent:done-pending-deploy issue, when you know whether its merge is live
# (a deploy record, say). <issue-json> has number, title and comments. No output keeps the default.

# agent_hook_labeler_trusted <issue>: vouch for an agent:ready issue no person labelled, such as one
# your own workflow filed and queued as the bot. Exit 0 only when you can vouch for its CURRENT title
# and body: the text becomes an agent PR. content_untouched_since <issue> <iso> (agent-state.sh)
# checks that nobody without write access changed it since <iso>.
